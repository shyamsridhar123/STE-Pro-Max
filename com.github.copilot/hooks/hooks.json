{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "python3 -I -B \"$STE_PROMAX_PLUGIN_ROOT/integrations/copilot/hook_entry.py\" --hook sessionStart",
        "powershell": "$ErrorActionPreference = 'Stop'; & python -I -B (Join-Path $env:STE_PROMAX_PLUGIN_ROOT 'integrations/copilot/hook_entry.py') --hook sessionStart; exit $LASTEXITCODE",
        "env": {
          "STE_PROMAX_PLUGIN_ROOT": "${PLUGIN_ROOT}",
          "STE_PROMAX_PLUGIN_DATA": "${PLUGIN_DATA}"
        },
        "timeoutSec": 120
      }
    ],
    "userPromptSubmitted": [
