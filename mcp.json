{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ste-promax": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-I",
        "-B",
        "${PLUGIN_ROOT}/integrations/mcp/server.py"
      ],
      "env": {
        "STE_PROMAX_PLUGIN_ROOT": "${PLUGIN_ROOT}",
        "STE_PROMAX_PLUGIN_DATA": "${PLUGIN_DATA}"
      }
    }
  }
}
